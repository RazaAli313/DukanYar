# Copy to .env and fill in. Never commit .env.

CORS_ORIGINS=http://localhost:3000

# Supabase — project URL + service_role key (backend bypasses RLS,
# so queries must filter by shop_id explicitly)
SUPABASE_URL=
SUPABASE_KEY=

# LLM — OpenAI-compatible endpoint (TEXT-2)
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Provider-specific reasoning effort (Groq/Qwen: none, Gemini 3: minimal;
# empty = omit the parameter entirely)
LLM_REASONING_EFFORT=none
# TEXT-3: prior turns replayed to the model per request. The thread itself is
# never truncated -- this caps only the prompt, so tokens/latency stay flat.
LLM_MAX_CONTEXT_TURNS=8

# Voice STT (VOICE-2)
STT_PROVIDER=speechmatics          # speechmatics | groq
STT_LANGUAGE=ur
# Comma-separated shop/product terms to bias code-switched English recognition
STT_EXTRA_VOCAB=coke,pepsi,sprite,fanta,sandwich,biscuit,chips,packet,kilo,gram,udhaar,khata,wasooli,sale
SPEECHMATICS_API_KEY=
SPEECHMATICS_OPERATING_POINT=enhanced   # standard | enhanced
# Groq whisper-large-v3 fallback (STT_PROVIDER=groq). Blank key reuses LLM_API_KEY.
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_API_KEY=

# Voice TTS (VOICE-3)
TTS_PROVIDER=edge                  # edge | azure
TTS_VOICE=ur-PK-AsadNeural         # or ur-PK-UzmaNeural (female)
TTS_RATE=+0%
TTS_TRANSLITERATE=true            # true = Groq Roman-Urdu -> Urdu script before synth
# Only needed for TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=               # e.g. eastus
