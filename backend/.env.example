# Copy to .env and fill in. Never commit .env.

CORS_ORIGINS=http://localhost:3000

# Supabase (Sheheryar) — leave blank until wired
SUPABASE_URL=
SUPABASE_KEY=

# LLM — OpenAI-compatible endpoint (TEXT-2)
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Provider-specific reasoning effort (Groq/Qwen: none, Gemini 3: minimal;
# empty = omit the parameter entirely)
LLM_REASONING_EFFORT=none
